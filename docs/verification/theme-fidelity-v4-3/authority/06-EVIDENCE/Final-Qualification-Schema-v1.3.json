{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rune Scribe Theme Fidelity v4.3 Final Qualification",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceSHA",
    "evidenceHeadSHA",
    "authoritySHA256",
    "canonicalCatalogSHA256",
    "gateCatalogSHA256",
    "counts",
    "supportingEvidence",
    "result",
    "acceptanceEvidence",
    "templateOnly"
  ],
  "properties": {
    "schemaVersion": { "const": "1.3" },
    "sourceSHA": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidenceHeadSHA": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authoritySHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "canonicalCatalogSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gateCatalogSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result": { "enum": ["PASS", "FAIL"] },
    "acceptanceEvidence": { "type": "boolean" },
    "templateOnly": { "type": "boolean" },
    "counts": {
      "type": "object",
      "required": [
        "canonicalCandidates",
        "responsiveEntries",
        "runtimeProbeInstances",
        "mappingResults",
        "gates"
      ]
    },
    "supportingEvidence": { "type": "object" }
  },
  "additionalProperties": true
}
