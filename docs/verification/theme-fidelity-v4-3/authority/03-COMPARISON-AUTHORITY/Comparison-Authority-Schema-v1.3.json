{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rune Scribe Theme Fidelity Comparison Authority v1.3",
  "type": "object",
  "required": [
    "schemaVersion",
    "authorityID",
    "expectedEntryCount",
    "entries",
    "thresholdProfiles",
    "evaluationModel"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3"
    },
    "authorityID": {
      "type": "string"
    },
    "expectedEntryCount": {
      "const": 400
    },
    "requiresFurtherOwnerInput": {
      "const": false
    },
    "entries": {
      "type": "array",
      "minItems": 400,
      "maxItems": 400
    },
    "thresholdProfiles": {
      "type": "object"
    },
    "evaluationModel": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
