{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runescribe.theme-fidelity.comparison-authority.schema.v1.2",
  "type": "object",
  "required": [
    "schemaVersion",
    "authorityID",
    "expectedEntryCount",
    "expectedReferenceMappingCount",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2"
    },
    "expectedEntryCount": {
      "const": 400
    },
    "reviewedEntryCount": {
      "const": 400
    },
    "unreviewedEntryCount": {
      "const": 0
    },
    "entries": {
      "type": "array",
      "minItems": 400,
      "maxItems": 400,
      "items": {
        "type": "object",
        "required": [
          "id",
          "seedID",
          "referenceMappingCount",
          "referenceMappings",
          "runtimeProbeIDs",
          "review"
        ],
        "properties": {
          "referenceMappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "mappingID",
                "referenceAsset",
                "referenceSHA256",
                "sourceCrop",
                "referenceRole",
                "scoreDisposition",
                "normalizationPolicy",
                "thresholdProfile",
                "focalRegion"
              ],
              "oneOf": [
                {
                  "required": [
                    "candidateElementID"
                  ]
                },
                {
                  "required": [
                    "candidateRendererOutputID"
                  ]
                },
                {
                  "required": [
                    "candidateProbeID"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  }
}
