      ]
    },
    {
      "id": "ACC-001",
      "category": "accessibility",
      "blocking": true,
      "description": "VoiceOver, Dynamic Type, focus, hit targets, no-color-only state, High Contrast, and all 20 exact Reduce Motion records pass.",
      "requiredEvidence": [
