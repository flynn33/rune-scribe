        "reduce-motion-runtime-evidence.json",
        "reduce-motion-frame-comparisons/"
      ],
      "dependsOn": [
        "UI-003"
      ]
    },
    {
      "id": "VIS-001",
      "category": "visual",
      "blocking": true,
      "description": "All 400 executable authority entries and all 1104 exact reference mappings pass through the declared metric, structural, runtime, or negative-invariant mode.",
      "requiredEvidence": [
        "visual-comparison-index.json",
        "comparison-authority-validation.json",
        "final-screenshots/",
        "focal-captures/",
        "heatmaps/",
        "responsive-layout-assertions.json"
      ],
      "dependsOn": [
        "UI-002",
        "UI-003",
        "ACC-001"
      ]
    },
    {
      "id": "TST-001",
      "category": "tests",
      "blocking": true,
      "description": "Swift package tests pass with zero failures.",
      "requiredEvidence": [
        "swift-test.log"
      ],
      "dependsOn": [
        "PRG-003"
      ]
    },
    {
      "id": "TST-002",
      "category": "tests",
      "blocking": true,
      "description": "macOS Release build, hosted tests, parity, resize, and visual suites pass.",
      "requiredEvidence": [
        "macos.json"
      ],
      "dependsOn": [
        "TST-001",
        "VIS-001"
      ]
    },
    {
      "id": "TST-003",
      "category": "tests",
      "blocking": true,
      "description": "iPhone Simulator Release build, hosted, UI, accessibility, and visual suites pass.",
      "requiredEvidence": [
        "iphone.json"
      ],
      "dependsOn": [
        "TST-001",
        "VIS-001"
      ]
    },
    {
      "id": "TST-004",
      "category": "tests",
      "blocking": true,
      "description": "iPad Simulator Release build, hosted, UI, accessibility, and visual suites pass.",
      "requiredEvidence": [
        "ipad.json"
      ],
      "dependsOn": [
        "TST-001",
        "VIS-001"
      ]
    },
    {
      "id": "REG-001",
      "category": "regression",
      "blocking": true,
      "description": "Cryptography, import/export, legacy payload, sharing transport, cloud, Game Center optionality, and shipping inspections pass.",
      "requiredEvidence": [
        "full-regression.json"
      ],
      "dependsOn": [
        "TST-002",
        "TST-003",
        "TST-004"
      ]
    },
    {
      "id": "NEG-001",
      "category": "negative",
      "blocking": true,
      "description": "All required negative mutations are rejected and the worktree is restored exactly.",
      "requiredEvidence": [
        "negative-mutations.json"
      ],
      "dependsOn": [
        "REG-001"
      ]
    },
    {
      "id": "DOC-001",
      "category": "documentation",
      "blocking": true,
      "description": "Current v4 docs, manifests, status, content catalog, and source-bound evidence are synchronized without rewriting historical evidence.",
      "requiredEvidence": [
        "documentation-alignment.json",
        "historical-evidence-boundary.json"
      ],
      "dependsOn": [
        "NEG-001"
      ]
    },
    {
      "id": "AUD-001",
      "category": "audit",
      "blocking": true,
      "description": "Final self-audit finds no omitted instruction, stale evidence, failed gate, open defect, or prohibited action.",
      "requiredEvidence": [
        "final-self-audit.md",
        "gate-summary.json"
      ],
      "dependsOn": [
        "DOC-001",
        "SRC-002"
      ]
