{
  "schemaVersion": "1.2",
  "gates": [
    {
      "id": "PKG-001",
      "category": "package",
      "blocking": true,
      "description": "v4.0, v4.1, and v4.2 package integrity passes; 400 entries, 1104 exact one-to-one reference mappings, candidate IDs, source-crop declarations, deterministic seeds, runtime probes, and asset hashes validate.",
      "requiredEvidence": [
        "package-validation.json",
        "comparison-authority-validation.json",
        "authority-asset-validation.json"
      ],
      "dependsOn": []
    },
    {
      "id": "SRC-001",
      "category": "source",
      "blocking": true,
      "description": "Work begins from fetched latest origin/main in an isolated clean worktree.",
      "requiredEvidence": [
        "baseline.json",
        "git-status.txt"
      ],
      "dependsOn": [
        "PKG-001"
      ]
    },
    {
      "id": "SRC-002",
      "category": "source",
      "blocking": true,
      "description": "Final evidence is bound to the proposed source head and no source changed afterward.",
      "requiredEvidence": [
        "source-manifest.json",
        "evidence-source-binding.json"
      ],
      "dependsOn": [
        "SRC-001"
      ]
    },
    {
      "id": "ARC-001",
      "category": "architecture",
      "blocking": true,
      "description": "Existing architecture and Forsetti mediation checks pass.",
      "requiredEvidence": [
        "architecture.log"
      ],
      "dependsOn": [
        "SRC-001"
      ]
    },
    {
      "id": "ARC-002",
      "category": "architecture",
      "blocking": true,
      "description": "Production UI imports no Theme implementation target and contains no provider-specific branch.",
      "requiredEvidence": [
        "theme-isolation.json",
        "negative-mutations.json"
      ],
      "dependsOn": [
        "ARC-001"
      ]
    },
    {
      "id": "AST-001",
      "category": "assets",
      "blocking": true,
      "description": "Every Theme resource is declared, uniquely owned, hash-valid, dimension-valid, and consumed.",
      "requiredEvidence": [
        "asset-inventory.json",
        "resource-coverage.json"
      ],
      "dependsOn": [
        "SRC-001"
      ]
    },
    {
      "id": "AST-002",
      "category": "assets",
      "blocking": true,
      "description": "No placeholder, rejected baseline, blank image, system-symbol Artifact substitute, or obsolete visual is shipped.",
      "requiredEvidence": [
        "asset-quality-audit.json",
        "negative-mutations.json"
      ],
      "dependsOn": [
        "AST-001"
      ]
    },
    {
      "id": "NORS-001",
      "category": "theme",
      "blocking": true,
      "description": "Norse descriptor content exactly matches the approved catalog.",
      "requiredEvidence": [
        "norse-catalog-validation.json"
      ],
      "dependsOn": [
        "AST-001"
      ]
    },
    {
      "id": "NORS-002",
      "category": "theme",
      "blocking": true,
      "description": "Norse Script, Relics, Seals, Frame, Crest, background, cards, and accessibility variants resolve and render.",
      "requiredEvidence": [
        "norse-resource-validation.json"
      ],
      "dependsOn": [
        "NORS-001"
      ]
    },
    {
      "id": "NORS-003",
      "category": "visual",
      "blocking": true,
      "description": "All Norse visual mappings pass and all four Base-owned vault-locked negative-invariant entries pass through their exact probes.",
