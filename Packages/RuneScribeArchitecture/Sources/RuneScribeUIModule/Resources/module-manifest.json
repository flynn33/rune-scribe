{
  "schemaVersion": "1.0",
  "policyProfile": "forsetti-pattern-b-standalone",
  "runtimeVersion": "1.0.0",
  "moduleID": "com.runescribe.module.ui",
  "displayName": "Rune Scribe Interface",
  "moduleVersion": "1.0.35",
